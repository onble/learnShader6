CCEffect %{
techniques:
  - passes:
      - vert: vs
        frag: fs
        blendState:
          targets:
            - blend: true
        rasterizerState:
          cullMode: none
        properties:
          texture: { value: white }
          alphaThreshold: { value: 0.5 }
          targetHue: { value: 240, editor: { tooltip: "目标色相值" } }
          hueRange: { value: 60, editor: { tooltip: "色相范围" } }
          hueRotationAngle: { value: 120, editor: { tooltip: "色相旋转角度" } }

}%


CCProgram vs %{
precision highp float;

#include <cc-global>
#include <cc-local>

in vec3 a_position;
in vec4 a_color;
out vec4 v_color;

#if USE_TEXTURE
  in vec2 a_uv0;
  out vec2 v_uv0;
#endif

void main() {
  vec4 pos = vec4(a_position, 1);
  
  #if CC_USE_MODEL
    pos = cc_matViewProj * cc_matWorld * pos;
  #else
    pos = cc_matViewProj * pos;
  #endif
  
  #if USE_TEXTURE
    v_uv0 = a_uv0;
  #endif
  
  v_color = a_color;
  
  gl_Position = pos;
}
}%


CCProgram fs %{
precision highp float;

#include <alpha-test>
#include <texture>

in vec4 v_color;

#if USE_TEXTURE
  in vec2 v_uv0;
  uniform sampler2D texture;
#endif
uniform HueColor {
  float targetHue;
  float hueRange;
  float hueRotationAngle;
};

vec3 rgbToHsv(vec3 rgb) {
  /**
  * RGB -> HSV（rgb 分量建议在 [0,1]）
  *
  * **实现原理（用最大/最小通道求圆柱坐标）**
  * - HSV 可看作把 RGB 立方体映射到“色相环 + 饱和度半径 + 明度高度”的圆柱坐标系。
  * - **V(明度/亮度)** 取 RGB 三通道的最大值：\(V = \max(r,g,b)\)。
  * - **C(色度/彩度)** 用最大最小差表示：\(C = \Delta = \max(r,g,b) - \min(r,g,b)\)。
  *   它刻画“离灰度轴( r=g=b )的距离”，灰度时 \(\Delta=0\)。
  * - **S(饱和度)** 定义为 \(S = C / V\)（当 \(V=0\) 或 \(C=0\) 时为 0）。
  * - **H(色相角)** 由“哪个通道最大”决定所处扇区，再用另外两通道的相对差值在该扇区内做线性插值，
*   最后乘 60° 并规整到 [0,360)。
  */
  
  float r = rgb.r;
  float g = rgb.g;
  float b = rgb.b;
  
  // min/max 用于得到亮度 V 与色度 C(=delta)
  float minVal = min(min(r, g), b);
  float maxVal = max(max(r, g), b);
  
  // delta = C：最大与最小通道的差，灰度(无色相)时为 0
  float delta = maxVal - minVal;
  
  // 默认输出：delta==0 时保持 h=0、s=0，v=maxVal（灰度退化）
  float h = 0.0;
  float s = 0.0;
  float v = maxVal;
  
  if (delta != 0.0) {
    // 根据“哪个通道最大”确定色相所在扇区，并计算扇区内的位置
    // 这里的 h 先以“扇区编号 + 小数偏移”的形式表示（单位：60° 的倍数）
    if (maxVal == r) {
      // R 为最大：扇区在 [0,60) 或 [300,360)，用 (g-b)/delta 作为插值
      h = (g - b) / delta;
    } else if (maxVal == g) {
      // G 为最大：扇区在 [60,180)，基准是 2，再加 (b-r)/delta 的偏移
      h = 2.0 + (b - r) / delta;
    } else {
      // B 为最大：扇区在 [180,300)，基准是 4，再加 (r-g)/delta 的偏移
      h = 4.0 + (r - g) / delta;
    }
    
    // 将“扇区倍数”转换为角度制（度）
    h *= 60.0;
    if (h < 0.0) {
      // 当落在负角度（典型是 R 最大且 b>g）时，加 360° 规整到 [0,360)
      h += 360.0;
    }
    
    // 饱和度：C 相对 V 的比例；V>0 时取 delta/maxVal
    s = delta / maxVal;
  }
  
  return vec3(h, s, v);
}

vec3 hsvToRgb(vec3 hsv) {
  /**
* HSV -> RGB（h 角度制：建议 [0, 360)，s/v：建议 [0, 1]）
*
* **实现原理（分段线性）**
* - 把色相环按 60° 分成 6 个扇区：R→Y→G→C→B→M→R。
* - 在每个扇区里，固定 V 与 S 后，RGB 在“去偏移”的基色空间 \((r',g',b')\) 是**分段线性插值**：
*   其中一个通道为 0，另一个为 C，第三个在 0..C 之间线性变化（即 X）。
* - 先算色度 C、第二大分量 X、亮度偏移 m；根据扇区把 (C, X, 0) 分配到 (r', g', b')；
*   最后加上 m 抬升所有通道，使最终最大通道值等于 V。
*/

// 拆分输入：h=色相(角度)，s=饱和度，v=明度/亮度
float h = hsv.x;
float s = hsv.y;
float v = hsv.z;

// C = 色度(chroma) = V * S
// - S=0 => C=0：没有“彩色成分”，最终会得到灰度 (V,V,V)
// - S 越大 => C 越大：颜色越“纯”
float c = v * s;

// X：当前扇区内“第二大通道”的值（0..C），用三角波构造线性变化
// 解释：令 t = h/60
// - mod(t, 2) 把 t 折回到 [0,2)
// - 1 - |mod(t,2) - 1| 形成 0→1→0 的三角波
// - X = C * 三角波
float x = c * (1.0 - abs(mod(h / 60.0, 2.0) - 1.0));

// m = V - C：把 (r',g',b') 共同上移的偏移量
// 因为在 (r',g',b') 中最大值为 C，加 m 后最大值变为 C+m = V，从而满足“明度”为 V。
float m = v - c;

// 先得到去偏移的 (r', g', b')（范围 0..C），最后统一加 m 得到最终 RGB
vec3 rgb;
if (h >= 0.0 && h < 60.0) {
  // 扇区 0：R 最大，G 线性上升，B 为 0   => (C, X, 0)
  rgb = vec3(c, x, 0.0);
} else if (h >= 60.0 && h < 120.0) {
  // 扇区 1：G 最大，R 线性下降，B 为 0   => (X, C, 0)
  rgb = vec3(x, c, 0.0);
} else if (h >= 120.0 && h < 180.0) {
  // 扇区 2：G 最大，B 线性上升，R 为 0   => (0, C, X)
  rgb = vec3(0.0, c, x);
} else if (h >= 180.0 && h < 240.0) {
  // 扇区 3：B 最大，G 线性下降，R 为 0   => (0, X, C)
  rgb = vec3(0.0, x, c);
} else if (h >= 240.0 && h < 300.0) {
  // 扇区 4：B 最大，R 线性上升，G 为 0   => (X, 0, C)
  rgb = vec3(x, 0.0, c);
} else {
  // 扇区 5：[300,360) 以及兜底：R 最大，B 线性下降，G 为 0 => (C, 0, X)
  rgb = vec3(c, 0.0, x);
}

// 加回 m：把最暗通道从 0 抬到 V-C，同时保持色度差为 C
return rgb + vec3(m);
}

/**
* 片元主函数：对“接近目标色相”的像素做色相旋转（Hue Rotation）。
*
* **颜色转换逻辑（为什么要 RGB ↔ HSV）**
* - 在 RGB 空间里“旋转色相”并不直观，因为 RGB 三通道耦合在一起，难以只改变色相而尽量保持明度与饱和度。
* - HSV 把颜色拆成：
*   - H：色相（角度，决定颜色“是什么色”）
*   - S：饱和度（颜色“有多纯”）
*   - V：明度/亮度（颜色“有多亮”）
* - 因此我们先把采样到的 RGB 转成 HSV，只在满足条件时修改 H，再转回 RGB 输出。
*
* **筛选逻辑**
* - 用 `targetHue ± hueRange` 定义一个色相区间；只有当像素的 H 落在该区间内，才应用 `hueRotationAngle`。
* - 这样可以做到“只改某一类颜色”（例如只改接近红色的区域），而不是全屏整体变色。
*/
void main() {
// 默认颜色（未启用纹理时相当于白色）
vec4 o = vec4(1, 1, 1, 1);

// 可选：从纹理取样原始颜色（使用 UV 坐标）
#if USE_TEXTURE
  o = texture2D(texture, v_uv0);
#endif

// RGB -> HSV：把“颜色”分解为 (色相H, 饱和度S, 明度V)
vec3 hsv = rgbToHsv(vec3(o.r, o.g, o.b));

// 定义需要被处理的色相窗口：目标色相附近 ± 范围
float minHue = targetHue - hueRange;
float maxHue = targetHue + hueRange;

// 只有色相落在窗口内的像素才做旋转：hsv.x += hueRotationAngle
if (hsv.x >= minHue && hsv.x <= maxHue) {
  hsv.x += hueRotationAngle; // 色相旋转：改变“是什么颜色”，尽量保留 S/V（纯度/亮度）
  
  // 色相回绕：把角度保持在 [0,360) 附近，避免超过 360° 后不在预期范围
  if (hsv.x > 360.0) {
    hsv.x -= 360.0;
  }
}

// HSV -> RGB：回到显示/输出所需的 RGB 空间
vec3 newColor = hsvToRgb(hsv);

// 输出：保留原 alpha（纹理透明度），并与顶点色相乘（常用于整体变色/透明度/批次颜色调制）
gl_FragColor = vec4(newColor, o.a) * v_color;
}
}%
