        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\nattribute vec4 a_color;\nvarying vec4 v_color;\n#if USE_TEXTURE\n  attribute vec2 a_uv0;\n  varying vec2 v_uv0;\n#endif\nvoid main() {\n  vec4 position = vec4(a_position, 1.0);\n  #if CC_USE_MODEL\n    position = cc_matViewProj * cc_matWorld * position;\n  #else\n    position = cc_matViewProj * position;\n  #endif\n  gl_Position = position;\n  v_color = a_color;\n  #if USE_TEXTURE\n    v_uv0 = a_uv0;\n  #endif\n}",
        "frag": "\nprecision highp float;\nuniform vec4 cc_time;\nvarying vec4 v_color;\n#if USE_TEXTURE\n  varying vec2 v_uv0;\n  uniform sampler2D texture;\n#endif\nuniform vec4 energyColor;\nuniform vec4 highlightColor;\nuniform vec4 blockColorA;\nuniform vec4 blockColorB;\nuniform vec4 blockColorC;\nuniform vec4 uvRect;\nuniform vec2 blockGrid;\nuniform float progress;\nuniform float scanWidth;\nuniform float scanIntensity;\nuniform float blockSpeed;\nuniform float blockIntensity;\nuniform float blockRange;\nuniform float fieldIntensity;\nuniform float columnWidth;\nuniform float rayDensity;\nuniform float raySpeed;\nuniform float glitchStrength;\nuniform float glitchRate;\nuniform float edgeFade;\nuniform float endFadeStart;\nuniform float flipY;\nfloat hash12(vec2 p) {\n  vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n  p3 += dot(p3, p3.yzx + 33.33);\n  return fract((p3.x + p3.y) * p3.z);\n}\nvoid main() {\n  vec2 uvSize = max(uvRect.zw, vec2(0.000001));\n  vec2 uv = (v_uv0 - uvRect.xy) / uvSize;\n  float time = cc_time.x;\n  float currentProgress = clamp(progress, 0.0, 1.0);\n  float localY = mix(1.0 - uv.y, uv.y, step(0.5, flipY));\n  float fadeWidth = max(edgeFade, 0.0001);\n  float edgeMaskX = smoothstep(0.0, fadeWidth, uv.x)\n    * (1.0 - smoothstep(1.0 - fadeWidth, 1.0, uv.x));\n  float edgeMaskY = smoothstep(0.0, fadeWidth, localY)\n    * (1.0 - smoothstep(1.0 - fadeWidth, 1.0, localY));\n  float edgeMask = edgeMaskX * edgeMaskY;\n  float startLife = 0.45 + 0.55 * smoothstep(0.0, 0.08, currentProgress);\n  float endLife = 1.0 - smoothstep(\n    clamp(endFadeStart, 0.0, 0.99),\n    1.0,\n    currentProgress\n  );\n  float life = startLife * endLife;\n  float frontDistance = abs(localY - currentProgress);\n  float safeScanWidth = max(scanWidth, 0.0001);\n  float scanBand = 1.0 - smoothstep(0.0, safeScanWidth, frontDistance);\n  float scanEcho = 1.0 - smoothstep(\n    0.0,\n    safeScanWidth * 2.6,\n    abs(localY - currentProgress + safeScanWidth * 2.2)\n  );\n  float halfColumn = max(columnWidth * 0.5, 0.001);\n  float column = 1.0 - smoothstep(\n    halfColumn * 0.62,\n    halfColumn,\n    abs(uv.x - 0.5)\n  );\n  float frontGlow = 1.0 - smoothstep(\n    0.0,\n    max(blockRange, 0.0001),\n    frontDistance\n  );\n  float softField = column * frontGlow * fieldIntensity;\n  float rayWave = 0.5 + 0.5 * sin(\n    (uv.x * max(rayDensity, 1.0) + time * 0.13) * 6.2831853\n  );\n  float thinRays = pow(rayWave, 18.0);\n  float rayPulse = 0.5 + 0.5 * sin(\n    (localY * 3.0 - time * raySpeed) * 6.2831853\n  );\n  thinRays *= column * frontGlow * mix(0.25, 1.0, rayPulse);\n  vec2 grid = max(blockGrid, vec2(1.0));\n  float blockRow = floor(localY * grid.y);\n  float rowDirection = hash12(vec2(blockRow, 4.17)) * 2.0 - 1.0;\n  float rowSpeed = mix(0.65, 1.45, hash12(vec2(blockRow, 12.83)));\n  float rowPhase = hash12(vec2(blockRow, 27.41)) * 6.2831853;\n  float verticalWobble = sin(time * 5.5 + rowPhase) * 0.012;\n  float glitchTick = floor(time * max(glitchRate, 0.01));\n  float rowGlitch = hash12(vec2(blockRow, glitchTick));\n  float glitchGate = step(0.72, rowGlitch);\n  float glitchDirection = hash12(vec2(blockRow + 31.7, glitchTick)) * 2.0 - 1.0;\n  float horizontalJump = glitchGate * glitchDirection * glitchStrength * grid.x;\n  vec2 blockUV = vec2(\n    uv.x * grid.x\n      + time * blockSpeed * rowSpeed * rowDirection\n      + horizontalJump,\n    (localY + verticalWobble) * grid.y\n  );\n  vec2 blockCell = floor(blockUV);\n  vec2 blockLocal = fract(blockUV);\n  float blockSeed = hash12(blockCell + vec2(3.1, 7.9));\n  float blockAlive = step(0.66, blockSeed);\n  float halfWidth = mix(0.24, 0.49, hash12(blockCell + 8.3));\n  float halfHeight = mix(0.04, 0.13, hash12(blockCell + 17.1));\n  float blockShape = step(abs(blockLocal.x - 0.5), halfWidth)\n    * step(abs(blockLocal.y - 0.5), halfHeight);\n  float blockZone = 1.0 - smoothstep(\n    0.0,\n    max(blockRange, 0.0001),\n    frontDistance\n  );\n  float blockPulse = smoothstep(\n    0.12,\n    0.72,\n    0.5 + 0.5 * sin(time * 15.0 + blockSeed * 20.0)\n  );\n  float blockAlpha = blockShape * blockAlive * blockZone * blockPulse;\n  blockAlpha *= blockIntensity;\n  vec2 grid2 = vec2(max(grid.x * 0.72, 1.0), max(grid.y * 1.18, 1.0));\n  float blockRow2 = floor((localY + 0.027) * grid2.y);\n  float rowDirection2 = hash12(vec2(blockRow2, 39.6)) * 2.0 - 1.0;\n  float rowSpeed2 = mix(0.75, 1.35, hash12(vec2(blockRow2, 51.2)));\n  vec2 blockUV2 = vec2(\n    uv.x * grid2.x\n      + time * blockSpeed * 0.78 * rowSpeed2 * rowDirection2\n      - horizontalJump * 0.55\n      + 0.37,\n    (localY - verticalWobble * 0.72 + 0.027) * grid2.y\n  );\n  vec2 blockCell2 = floor(blockUV2);\n  vec2 blockLocal2 = fract(blockUV2);\n  float blockSeed2 = hash12(blockCell2 + vec2(61.4, 19.7));\n  float blockAlive2 = step(0.73, blockSeed2);\n  float halfWidth2 = mix(0.28, 0.49, hash12(blockCell2 + 23.7));\n  float halfHeight2 = mix(0.035, 0.095, hash12(blockCell2 + 42.6));\n  float blockShape2 = step(abs(blockLocal2.x - 0.5), halfWidth2)\n    * step(abs(blockLocal2.y - 0.5), halfHeight2);\n  float blockPulse2 = smoothstep(\n    0.18,\n    0.76,\n    0.5 + 0.5 * sin(time * 18.0 + blockSeed2 * 24.0)\n  );\n  float blockAlpha2 = blockShape2 * blockAlive2 * blockZone * blockPulse2;\n  blockAlpha2 *= blockIntensity * 0.86;\n  float blockColorKey = hash12(blockCell + vec2(91.3, 44.1));\n  vec3 blockRGB = mix(blockColorA.rgb, blockColorB.rgb, step(0.46, blockColorKey));\n  blockRGB = mix(blockRGB, blockColorC.rgb, step(0.82, blockColorKey));\n  float blockColorKey2 = hash12(blockCell2 + vec2(73.8, 102.4));\n  vec3 blockRGB2 = mix(blockColorA.rgb, blockColorB.rgb, step(0.42, blockColorKey2));\n  blockRGB2 = mix(blockRGB2, blockColorC.rgb, step(0.78, blockColorKey2));\n  float combinedBlockAlpha = max(blockAlpha, blockAlpha2);\n  vec3 combinedBlockRGB = mix(\n    blockRGB,\n    blockRGB2,\n    step(blockAlpha, blockAlpha2)\n  );\n  float streakRow = floor(localY * 46.0);\n  float streakSeed = hash12(vec2(streakRow, glitchTick));\n  float streakGate = step(0.88, streakSeed);\n  float streakDirection = hash12(vec2(streakRow + 5.8, 31.2)) * 2.0 - 1.0;\n  float streakCenter = fract(\n    hash12(vec2(streakRow + 9.4, glitchTick))\n      + time * blockSpeed * 0.18 * streakDirection\n  );\n  float streakWidth = mix(0.08, 0.26, hash12(vec2(streakRow + 18.2, glitchTick)));\n  float streak = 1.0 - smoothstep(\n    streakWidth,\n    streakWidth + 0.012,\n    abs(uv.x - streakCenter)\n  );\n  streak *= streakGate * blockZone;\n  float scanAlpha = (scanBand * 0.88 + scanEcho * 0.28) * column;\n  float rayAlpha = thinRays * fieldIntensity * 0.7;\n  float fieldAlpha = softField * 0.42;\n  float streakAlpha = streak * blockIntensity * 0.68;\n  float effectAlpha = max(scanAlpha, combinedBlockAlpha);\n  effectAlpha = max(effectAlpha, rayAlpha + fieldAlpha);\n  effectAlpha = max(effectAlpha, streakAlpha);\n  effectAlpha *= edgeMask * life * v_color.a;\n  if (effectAlpha < 0.001) {\n    discard;\n  }\n  float highlight = clamp(\n    scanBand * scanIntensity + combinedBlockAlpha * 0.32,\n    0.0,\n    1.0\n  );\n  vec3 color = mix(energyColor.rgb, highlightColor.rgb, highlight);\n  float streakColorKey = hash12(vec2(streakRow, glitchTick + 67.3));\n  vec3 streakRGB = mix(blockColorA.rgb, blockColorB.rgb, step(0.38, streakColorKey));\n  streakRGB = mix(streakRGB, blockColorC.rgb, step(0.84, streakColorKey));\n  float dataAlpha = max(combinedBlockAlpha, streakAlpha);\n  vec3 dataRGB = mix(\n    combinedBlockRGB,\n    streakRGB,\n    step(combinedBlockAlpha, streakAlpha)\n  );\n  float dataMix = clamp(dataAlpha / max(effectAlpha, 0.0001), 0.0, 1.0);\n  color = mix(color, dataRGB, dataMix * 0.92);\n  color *= 0.82 + scanBand * scanIntensity + thinRays * 0.45;\n  color *= v_color.rgb;\n  gl_FragColor = vec4(color, clamp(effectAlpha, 0.0, 1.0));\n}"
      },
      "glsl3": {
        "vert": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nuniform CCLocal {\n  mat4 cc_matWorld;\n  mat4 cc_matWorldIT;\n};\nin vec3 a_position;\nin vec4 a_color;\nout vec4 v_color;\n#if USE_TEXTURE\n  in vec2 a_uv0;\n  out vec2 v_uv0;\n#endif\nvoid main() {\n  vec4 position = vec4(a_position, 1.0);\n  #if CC_USE_MODEL\n    position = cc_matViewProj * cc_matWorld * position;\n  #else\n    position = cc_matViewProj * position;\n  #endif\n  gl_Position = position;\n  v_color = a_color;\n  #if USE_TEXTURE\n    v_uv0 = a_uv0;\n  #endif\n}",
