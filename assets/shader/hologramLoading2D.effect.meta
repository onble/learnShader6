      "glsl1": {
        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\nattribute vec4 a_color;\nvarying vec4 v_color;\n#if USE_TEXTURE\n  attribute vec2 a_uv0;\n  varying vec2 v_uv0;\n#endif\nvoid main() {\n  vec4 position = vec4(a_position, 1.0);\n  #if CC_USE_MODEL\n    position = cc_matViewProj * cc_matWorld * position;\n  #else\n    position = cc_matViewProj * position;\n  #endif\n  gl_Position = position;\n  v_color = a_color;\n  #if USE_TEXTURE\n    v_uv0 = a_uv0;\n  #endif\n}",
        "frag": "\nprecision highp float;\nuniform vec4 cc_time;\nvarying vec4 v_color;\n#if USE_TEXTURE\n  varying vec2 v_uv0;\n  uniform sampler2D texture;\n#endif\nuniform vec4 energyColor;\nuniform vec4 highlightColor;\nuniform vec4 uvRect;\nuniform vec2 blockGrid;\nuniform float progress;\nuniform float scanWidth;\nuniform float scanIntensity;\nuniform float blockSpeed;\nuniform float blockIntensity;\nuniform float blockRange;\nuniform float fieldIntensity;\nuniform float columnWidth;\nuniform float rayDensity;\nuniform float raySpeed;\nuniform float glitchStrength;\nuniform float glitchRate;\nuniform float edgeFade;\nuniform float endFadeStart;\nuniform float flipY;\nfloat hash12(vec2 p) {\n  vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n  p3 += dot(p3, p3.yzx + 33.33);\n  return fract((p3.x + p3.y) * p3.z);\n}\nvoid main() {\n  vec2 uvSize = max(uvRect.zw, vec2(0.000001));\n  vec2 uv = (v_uv0 - uvRect.xy) / uvSize;\n  float time = cc_time.x;\n  float currentProgress = clamp(progress, 0.0, 1.0);\n  float localY = mix(1.0 - uv.y, uv.y, step(0.5, flipY));\n  float fadeWidth = max(edgeFade, 0.0001);\n  float edgeMaskX = smoothstep(0.0, fadeWidth, uv.x)\n    * (1.0 - smoothstep(1.0 - fadeWidth, 1.0, uv.x));\n  float edgeMaskY = smoothstep(0.0, fadeWidth, localY)\n    * (1.0 - smoothstep(1.0 - fadeWidth, 1.0, localY));\n  float edgeMask = edgeMaskX * edgeMaskY;\n  float startLife = 0.45 + 0.55 * smoothstep(0.0, 0.08, currentProgress);\n  float endLife = 1.0 - smoothstep(\n    clamp(endFadeStart, 0.0, 0.99),\n    1.0,\n    currentProgress\n  );\n  float life = startLife * endLife;\n  float frontDistance = abs(localY - currentProgress);\n  float safeScanWidth = max(scanWidth, 0.0001);\n  float scanBand = 1.0 - smoothstep(0.0, safeScanWidth, frontDistance);\n  float scanEcho = 1.0 - smoothstep(\n    0.0,\n    safeScanWidth * 2.6,\n    abs(localY - currentProgress + safeScanWidth * 2.2)\n  );\n  float halfColumn = max(columnWidth * 0.5, 0.001);\n  float column = 1.0 - smoothstep(\n    halfColumn * 0.62,\n    halfColumn,\n    abs(uv.x - 0.5)\n  );\n  float frontGlow = 1.0 - smoothstep(\n    0.0,\n    max(blockRange, 0.0001),\n    frontDistance\n  );\n  float softField = column * frontGlow * fieldIntensity;\n  float rayWave = 0.5 + 0.5 * sin(\n    (uv.x * max(rayDensity, 1.0) + time * 0.13) * 6.2831853\n  );\n  float thinRays = pow(rayWave, 18.0);\n  float rayPulse = 0.5 + 0.5 * sin(\n    (localY * 3.0 - time * raySpeed) * 6.2831853\n  );\n  thinRays *= column * frontGlow * mix(0.25, 1.0, rayPulse);\n  vec2 grid = max(blockGrid, vec2(1.0));\n  float blockRow = floor(localY * grid.y);\n  float rowDirection = hash12(vec2(blockRow, 4.17)) * 2.0 - 1.0;\n  float glitchTick = floor(time * max(glitchRate, 0.01));\n  float rowGlitch = hash12(vec2(blockRow, glitchTick));\n  float glitchGate = step(0.72, rowGlitch);\n  float glitchDirection = hash12(vec2(blockRow + 31.7, glitchTick)) * 2.0 - 1.0;\n  float horizontalJump = glitchGate * glitchDirection * glitchStrength * grid.x;\n  vec2 blockUV = vec2(\n    uv.x * grid.x + time * blockSpeed * rowDirection + horizontalJump,\n    localY * grid.y\n  );\n  vec2 blockCell = floor(blockUV);\n  vec2 blockLocal = fract(blockUV);\n  float blockSeed = hash12(blockCell + floor(time * 7.0));\n  float blockAlive = step(0.69, blockSeed);\n  float halfWidth = mix(0.16, 0.47, hash12(blockCell + 8.3));\n  float halfHeight = mix(0.07, 0.22, hash12(blockCell + 17.1));\n  float blockShape = step(abs(blockLocal.x - 0.5), halfWidth)\n    * step(abs(blockLocal.y - 0.5), halfHeight);\n  float blockZone = 1.0 - smoothstep(\n    0.0,\n    max(blockRange, 0.0001),\n    frontDistance\n  );\n  float blockPulse = 0.52 + 0.48 * sin(time * 17.0 + blockSeed * 20.0);\n  float blockAlpha = blockShape * blockAlive * blockZone * blockPulse;\n  blockAlpha *= blockIntensity;\n  float streakRow = floor(localY * 46.0);\n  float streakSeed = hash12(vec2(streakRow, glitchTick));\n  float streakGate = step(0.88, streakSeed);\n  float streakCenter = hash12(vec2(streakRow + 9.4, glitchTick));\n  float streakWidth = mix(0.08, 0.26, hash12(vec2(streakRow + 18.2, glitchTick)));\n  float streak = 1.0 - smoothstep(\n    streakWidth,\n    streakWidth + 0.012,\n    abs(uv.x - streakCenter)\n  );\n  streak *= streakGate * blockZone;\n  float scanAlpha = (scanBand * 0.88 + scanEcho * 0.28) * column;\n  float rayAlpha = thinRays * fieldIntensity * 0.7;\n  float fieldAlpha = softField * 0.42;\n  float streakAlpha = streak * blockIntensity * 0.68;\n  float effectAlpha = max(scanAlpha, blockAlpha);\n  effectAlpha = max(effectAlpha, rayAlpha + fieldAlpha);\n  effectAlpha = max(effectAlpha, streakAlpha);\n  effectAlpha *= edgeMask * life * v_color.a;\n  if (effectAlpha < 0.001) {\n    discard;\n  }\n  float highlight = clamp(\n    scanBand * scanIntensity + blockAlpha * 0.65 + streakAlpha,\n    0.0,\n    1.0\n  );\n  vec3 color = mix(energyColor.rgb, highlightColor.rgb, highlight);\n  color *= 0.82 + scanBand * scanIntensity + thinRays * 0.45;\n  color *= v_color.rgb;\n  gl_FragColor = vec4(color, clamp(effectAlpha, 0.0, 1.0));\n}"
      },
      "glsl3": {
        "vert": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nuniform CCLocal {\n  mat4 cc_matWorld;\n  mat4 cc_matWorldIT;\n};\nin vec3 a_position;\nin vec4 a_color;\nout vec4 v_color;\n#if USE_TEXTURE\n  in vec2 a_uv0;\n  out vec2 v_uv0;\n#endif\nvoid main() {\n  vec4 position = vec4(a_position, 1.0);\n  #if CC_USE_MODEL\n    position = cc_matViewProj * cc_matWorld * position;\n  #else\n    position = cc_matViewProj * position;\n  #endif\n  gl_Position = position;\n  v_color = a_color;\n  #if USE_TEXTURE\n    v_uv0 = a_uv0;\n  #endif\n}",
        "frag": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nin vec4 v_color;\n#if USE_TEXTURE\n  in vec2 v_uv0;\n  uniform sampler2D texture;\n#endif\nuniform HologramLoading {\n  vec4 energyColor;\n  vec4 highlightColor;\n  vec4 uvRect;\n  vec2 blockGrid;\n  float progress;\n  float scanWidth;\n  float scanIntensity;\n  float blockSpeed;\n  float blockIntensity;\n  float blockRange;\n  float fieldIntensity;\n  float columnWidth;\n  float rayDensity;\n  float raySpeed;\n  float glitchStrength;\n  float glitchRate;\n  float edgeFade;\n  float endFadeStart;\n  float flipY;\n};\nfloat hash12(vec2 p) {\n  vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n  p3 += dot(p3, p3.yzx + 33.33);\n  return fract((p3.x + p3.y) * p3.z);\n}\nvoid main() {\n  vec2 uvSize = max(uvRect.zw, vec2(0.000001));\n  vec2 uv = (v_uv0 - uvRect.xy) / uvSize;\n  float time = cc_time.x;\n  float currentProgress = clamp(progress, 0.0, 1.0);\n  float localY = mix(1.0 - uv.y, uv.y, step(0.5, flipY));\n  float fadeWidth = max(edgeFade, 0.0001);\n  float edgeMaskX = smoothstep(0.0, fadeWidth, uv.x)\n    * (1.0 - smoothstep(1.0 - fadeWidth, 1.0, uv.x));\n  float edgeMaskY = smoothstep(0.0, fadeWidth, localY)\n    * (1.0 - smoothstep(1.0 - fadeWidth, 1.0, localY));\n  float edgeMask = edgeMaskX * edgeMaskY;\n  float startLife = 0.45 + 0.55 * smoothstep(0.0, 0.08, currentProgress);\n  float endLife = 1.0 - smoothstep(\n    clamp(endFadeStart, 0.0, 0.99),\n    1.0,\n    currentProgress\n  );\n  float life = startLife * endLife;\n  float frontDistance = abs(localY - currentProgress);\n  float safeScanWidth = max(scanWidth, 0.0001);\n  float scanBand = 1.0 - smoothstep(0.0, safeScanWidth, frontDistance);\n  float scanEcho = 1.0 - smoothstep(\n    0.0,\n    safeScanWidth * 2.6,\n    abs(localY - currentProgress + safeScanWidth * 2.2)\n  );\n  float halfColumn = max(columnWidth * 0.5, 0.001);\n  float column = 1.0 - smoothstep(\n    halfColumn * 0.62,\n    halfColumn,\n    abs(uv.x - 0.5)\n  );\n  float frontGlow = 1.0 - smoothstep(\n    0.0,\n    max(blockRange, 0.0001),\n    frontDistance\n  );\n  float softField = column * frontGlow * fieldIntensity;\n  float rayWave = 0.5 + 0.5 * sin(\n    (uv.x * max(rayDensity, 1.0) + time * 0.13) * 6.2831853\n  );\n  float thinRays = pow(rayWave, 18.0);\n  float rayPulse = 0.5 + 0.5 * sin(\n    (localY * 3.0 - time * raySpeed) * 6.2831853\n  );\n  thinRays *= column * frontGlow * mix(0.25, 1.0, rayPulse);\n  vec2 grid = max(blockGrid, vec2(1.0));\n  float blockRow = floor(localY * grid.y);\n  float rowDirection = hash12(vec2(blockRow, 4.17)) * 2.0 - 1.0;\n  float glitchTick = floor(time * max(glitchRate, 0.01));\n  float rowGlitch = hash12(vec2(blockRow, glitchTick));\n  float glitchGate = step(0.72, rowGlitch);\n  float glitchDirection = hash12(vec2(blockRow + 31.7, glitchTick)) * 2.0 - 1.0;\n  float horizontalJump = glitchGate * glitchDirection * glitchStrength * grid.x;\n  vec2 blockUV = vec2(\n    uv.x * grid.x + time * blockSpeed * rowDirection + horizontalJump,\n    localY * grid.y\n  );\n  vec2 blockCell = floor(blockUV);\n  vec2 blockLocal = fract(blockUV);\n  float blockSeed = hash12(blockCell + floor(time * 7.0));\n  float blockAlive = step(0.69, blockSeed);\n  float halfWidth = mix(0.16, 0.47, hash12(blockCell + 8.3));\n  float halfHeight = mix(0.07, 0.22, hash12(blockCell + 17.1));\n  float blockShape = step(abs(blockLocal.x - 0.5), halfWidth)\n    * step(abs(blockLocal.y - 0.5), halfHeight);\n  float blockZone = 1.0 - smoothstep(\n    0.0,\n    max(blockRange, 0.0001),\n    frontDistance\n  );\n  float blockPulse = 0.52 + 0.48 * sin(time * 17.0 + blockSeed * 20.0);\n  float blockAlpha = blockShape * blockAlive * blockZone * blockPulse;\n  blockAlpha *= blockIntensity;\n  float streakRow = floor(localY * 46.0);\n  float streakSeed = hash12(vec2(streakRow, glitchTick));\n  float streakGate = step(0.88, streakSeed);\n  float streakCenter = hash12(vec2(streakRow + 9.4, glitchTick));\n  float streakWidth = mix(0.08, 0.26, hash12(vec2(streakRow + 18.2, glitchTick)));\n  float streak = 1.0 - smoothstep(\n    streakWidth,\n    streakWidth + 0.012,\n    abs(uv.x - streakCenter)\n  );\n  streak *= streakGate * blockZone;\n  float scanAlpha = (scanBand * 0.88 + scanEcho * 0.28) * column;\n  float rayAlpha = thinRays * fieldIntensity * 0.7;\n  float fieldAlpha = softField * 0.42;\n  float streakAlpha = streak * blockIntensity * 0.68;\n  float effectAlpha = max(scanAlpha, blockAlpha);\n  effectAlpha = max(effectAlpha, rayAlpha + fieldAlpha);\n  effectAlpha = max(effectAlpha, streakAlpha);\n  effectAlpha *= edgeMask * life * v_color.a;\n  if (effectAlpha < 0.001) {\n    discard;\n  }\n  float highlight = clamp(\n    scanBand * scanIntensity + blockAlpha * 0.65 + streakAlpha,\n    0.0,\n    1.0\n  );\n  vec3 color = mix(energyColor.rgb, highlightColor.rgb, highlight);\n  color *= 0.82 + scanBand * scanIntensity + thinRays * 0.45;\n  color *= v_color.rgb;\n  gl_FragColor = vec4(color, clamp(effectAlpha, 0.0, 1.0));\n}"
