        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\nattribute vec4 a_color;\nvarying vec4 v_color;\n#if USE_TEXTURE\n  attribute vec2 a_uv0;\n  varying vec2 v_uv0;\n#endif\nvoid main() {\n  vec4 position = vec4(a_position, 1.0);\n  #if CC_USE_MODEL\n    position = cc_matViewProj * cc_matWorld * position;\n  #else\n    position = cc_matViewProj * position;\n  #endif\n  gl_Position = position;\n  v_color = a_color;\n  #if USE_TEXTURE\n    v_uv0 = a_uv0;\n  #endif\n}",
        "frag": "\nprecision highp float;\nvarying vec4 v_color;\n#if USE_TEXTURE\n  varying vec2 v_uv0;\n  uniform sampler2D texture;\n#endif\nuniform vec4 energyColor;\nuniform vec4 highlightColor;\nuniform vec4 blockColorA;\nuniform vec4 blockColorB;\nuniform vec4 blockColorC;\nuniform vec4 uvRect;\nuniform vec2 blockGrid;\nuniform float progress;\nuniform float scanWidth;\nuniform float scanIntensity;\nuniform float blockSpeed;\nuniform float blockIntensity;\nuniform float blockRange;\nuniform float fieldIntensity;\nuniform float columnWidth;\nuniform float rayDensity;\nuniform float raySpeed;\nuniform float glitchStrength;\nuniform float glitchRate;\nuniform float edgeFade;\nuniform float endFadeStart;\nuniform float flipY;\nfloat hash12(vec2 p) {\n  vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n  p3 += dot(p3, p3.yzx + 33.33);\n  return fract((p3.x + p3.y) * p3.z);\n}\nvec3 getDataColor(float key) {\n  vec3 color = blockColorA.rgb;\n  color = mix(color, blockColorB.rgb, step(0.46, key));\n  color = mix(color, blockColorC.rgb, step(0.74, key));\n  color = mix(color, highlightColor.rgb, step(0.9, key));\n  return color;\n}\nvoid main() {\n  vec2 uvSize = max(uvRect.zw, vec2(0.000001));\n  vec2 uv = (v_uv0 - uvRect.xy) / uvSize;\n  float currentProgress = clamp(progress, 0.0, 1.0);\n  float localY = mix(1.0 - uv.y, uv.y, step(0.5, flipY));\n  float fadeWidth = max(edgeFade, 0.0001);\n  float edgeMaskX = smoothstep(0.0, fadeWidth, uv.x)\n    * (1.0 - smoothstep(1.0 - fadeWidth, 1.0, uv.x));\n  float edgeMaskY = smoothstep(0.0, fadeWidth, localY)\n    * (1.0 - smoothstep(1.0 - fadeWidth, 1.0, localY));\n  float edgeMask = edgeMaskX * edgeMaskY;\n  float phaseOn = smoothstep(0.0, 0.035, currentProgress);\n  float columnRise = smoothstep(0.0, 0.068, currentProgress);\n  float columnFall = 1.0 - smoothstep(0.068, 0.159, currentProgress);\n  float columnLife = columnRise * columnFall;\n  float fieldLife = phaseOn\n    * (1.0 - smoothstep(0.11, 0.21, currentProgress));\n  float tailLife = phaseOn * (\n    1.0 - smoothstep(\n      clamp(endFadeStart, 0.8, 0.99),\n      1.0,\n      currentProgress\n    )\n  );\n  float rapidCull = smoothstep(0.38, 0.58, currentProgress);\n  float finalCull = smoothstep(0.72, 0.94, currentProgress);\n  float halfColumn = max(columnWidth * 0.5, 0.001);\n  float centerDistance = abs(uv.x - 0.5);\n  float columnCore = 1.0 - smoothstep(\n    halfColumn * 0.22,\n    halfColumn,\n    centerDistance\n  );\n  float columnGlow = 1.0 - smoothstep(\n    halfColumn * 0.62,\n    min(0.5, halfColumn * 1.3),\n    centerDistance\n  );\n  float verticalMask = smoothstep(0.0, 0.055, localY)\n    * (1.0 - smoothstep(0.94, 1.0, localY));\n  float columnTick = floor(currentProgress * max(glitchRate, 1.0) * 0.5);\n  float horizontalSlice = mix(\n    0.62,\n    1.0,\n    hash12(vec2(floor(localY * 32.0), columnTick))\n  );\n  float rayWave = 0.5 + 0.5 * sin(\n    (uv.x * max(rayDensity, 1.0) + currentProgress * 0.7) * 6.2831853\n  );\n  float thinRays = pow(rayWave, 18.0);\n  float rayPulse = 0.5 + 0.5 * sin(\n    (localY * 3.0 - currentProgress * raySpeed) * 6.2831853\n  );\n  thinRays *= columnCore * verticalMask * mix(0.28, 1.0, rayPulse);\n  float safeScanWidth = max(scanWidth, 0.0001);\n  float baseLine = 1.0 - smoothstep(\n    safeScanWidth,\n    safeScanWidth * 2.2,\n    localY\n  );\n  float baseHalo = 1.0 - smoothstep(0.0, 0.24, localY);\n  float baseLife = smoothstep(0.0, 0.0225, currentProgress)\n    * (1.0 - smoothstep(0.08, 0.17, currentProgress));\n  float columnAlpha = columnCore * verticalMask * horizontalSlice;\n  columnAlpha *= columnLife * fieldIntensity;\n  columnAlpha += thinRays * columnLife * fieldIntensity * 0.75;\n  float fieldAlpha = columnGlow * verticalMask * fieldLife * fieldIntensity * 0.28;\n  float baseAlpha = (baseLine * 0.9 + baseHalo * 0.42)\n    * baseLife\n    * fieldIntensity;\n  vec2 grid = max(blockGrid, vec2(1.0));\n  float glitchTime = currentProgress * max(glitchRate, 1.0);\n  float glitchTick = floor(glitchTime);\n  float glitchPhase = fract(glitchTime);\n  float aliveThreshold = mix(0.57, 0.9, rapidCull);\n  aliveThreshold = mix(aliveThreshold, 1.001, finalCull);\n  float blockRow = floor(localY * grid.y);\n  float blockRowLocal = fract(localY * grid.y);\n  float blockSeed = hash12(vec2(blockRow + 3.1, 7.9));\n  float blockAlive = step(aliveThreshold, blockSeed);\n  float blockCenterSeed = hash12(vec2(blockRow + 21.7, glitchTick + 39.2));\n  float blockCenter = (\n    floor(blockCenterSeed * grid.x) + 0.5\n  ) / grid.x;\n  float blockDirection = hash12(vec2(blockRow + 61.3, glitchTick)) * 2.0 - 1.0;\n  blockCenter += (glitchPhase - 0.5)\n    * glitchStrength\n    * blockSpeed\n    * blockDirection;\n  float blockHalfWidth = mix(\n    0.025,\n    max(blockRange, 0.05) * 0.42,\n    hash12(vec2(blockRow + 12.6, glitchTick + 91.4))\n  );\n  float blockHalfHeight = mix(\n    0.055,\n    0.17,\n    hash12(vec2(blockRow + 31.8, glitchTick + 16.2))\n  );\n  float blockX = 1.0 - smoothstep(\n    blockHalfWidth,\n    blockHalfWidth + 0.012,\n    abs(uv.x - blockCenter)\n  );\n  float blockY = 1.0 - smoothstep(\n    blockHalfHeight,\n    blockHalfHeight + 0.08,\n    abs(blockRowLocal - 0.5)\n  );\n  float blockAlpha = blockX * blockY * blockAlive * tailLife * blockIntensity;\n  vec3 blockRGB = getDataColor(\n    hash12(vec2(blockRow + 71.2, glitchTick + 22.4))\n  );\n  float gridY2 = max(grid.y * 1.37, 1.0);\n  float blockRow2 = floor((localY + 0.013) * gridY2);\n  float blockRowLocal2 = fract((localY + 0.013) * gridY2);\n  float glitchTick2 = floor(glitchTime + 2.7);\n  float blockSeed2 = hash12(vec2(blockRow2 + 44.6, 5.3));\n  float blockAlive2 = step(aliveThreshold + 0.045, blockSeed2);\n  float blockCenterSeed2 = hash12(vec2(blockRow2 + 82.1, glitchTick2 + 33.7));\n  float blockCenter2 = (\n    floor(blockCenterSeed2 * grid.x) + 0.5\n  ) / grid.x;\n  float blockDirection2 = hash12(vec2(blockRow2 + 17.9, glitchTick2)) * 2.0 - 1.0;\n  blockCenter2 -= (glitchPhase - 0.5)\n    * glitchStrength\n    * blockSpeed\n    * 0.72\n    * blockDirection2;\n  float blockHalfWidth2 = mix(\n    0.018,\n    max(blockRange, 0.05) * 0.32,\n    hash12(vec2(blockRow2 + 24.3, glitchTick2 + 62.5))\n  );\n  float blockHalfHeight2 = mix(\n    0.045,\n    0.13,\n    hash12(vec2(blockRow2 + 13.5, glitchTick2 + 49.8))\n  );\n  float blockX2 = 1.0 - smoothstep(\n    blockHalfWidth2,\n    blockHalfWidth2 + 0.01,\n    abs(uv.x - blockCenter2)\n  );\n  float blockY2 = 1.0 - smoothstep(\n    blockHalfHeight2,\n    blockHalfHeight2 + 0.07,\n    abs(blockRowLocal2 - 0.5)\n  );\n  float blockAlpha2 = blockX2 * blockY2 * blockAlive2 * tailLife;\n  blockAlpha2 *= blockIntensity * 0.84;\n  vec3 blockRGB2 = getDataColor(\n    hash12(vec2(blockRow2 + 8.7, glitchTick2 + 104.2))\n  );\n  float pixelRow = floor(localY * 43.0);\n  float pixelRowLocal = fract(localY * 43.0);\n  float pixelSeed = hash12(vec2(pixelRow + 55.8, 18.4));\n  float pixelThreshold = mix(0.88, 0.97, rapidCull);\n  pixelThreshold = mix(pixelThreshold, 1.001, finalCull);\n  float pixelAlive = step(pixelThreshold, pixelSeed);\n  float pixelCenter = hash12(vec2(pixelRow + 91.6, glitchTick + 3.2));\n  float pixelHalfWidth = mix(\n    0.012,\n    0.045,\n    hash12(vec2(pixelRow + 14.9, glitchTick + 73.1))\n  );\n  float pixelX = 1.0 - smoothstep(\n    pixelHalfWidth,\n    pixelHalfWidth + 0.006,\n    abs(uv.x - pixelCenter)\n  );\n  float pixelY = 1.0 - smoothstep(\n    0.055,\n    0.12,\n    abs(pixelRowLocal - 0.5)\n  );\n  float pixelAlpha = pixelX * pixelY * pixelAlive * tailLife;\n  pixelAlpha *= blockIntensity * 0.72;\n  float combinedBlockAlpha = max(blockAlpha, blockAlpha2);\n  vec3 combinedBlockRGB = mix(blockRGB, blockRGB2, step(blockAlpha, blockAlpha2));\n  float dataAlpha = max(combinedBlockAlpha, pixelAlpha);\n  vec3 dataRGB = mix(\n    combinedBlockRGB,\n    highlightColor.rgb,\n    step(combinedBlockAlpha, pixelAlpha)\n  );\n  float energyAlpha = max(columnAlpha, fieldAlpha);\n  energyAlpha = max(energyAlpha, baseAlpha);\n  float effectAlpha = max(energyAlpha, dataAlpha);\n  effectAlpha *= edgeMask * v_color.a;\n  if (effectAlpha < 0.001) {\n    discard;\n  }\n  float centerHot = columnCore * columnLife;\n  vec3 energyRGB = mix(\n    energyColor.rgb,\n    highlightColor.rgb,\n    clamp(centerHot * 0.82 + baseLine * baseLife, 0.0, 1.0)\n  );\n  float dataMix = clamp(dataAlpha / max(effectAlpha, 0.0001), 0.0, 1.0);\n  vec3 color = mix(energyRGB, dataRGB, dataMix);\n  color *= 0.88\n    + columnLife * scanIntensity * 0.56\n    + thinRays * columnLife * 0.48;\n  color *= v_color.rgb;\n  gl_FragColor = vec4(color, clamp(effectAlpha, 0.0, 1.0));\n}"
