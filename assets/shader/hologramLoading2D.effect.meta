canEcho = 1.0 - smoothstep(\n    0.0,\n    safeScanWidth * 2.6,\n    abs(localY - currentProgress + safeScanWidth * 2.2)\n  );\n  float halfColumn = max(columnWidth * 0.5, 0.001);\n  float column = 1.0 - smoothstep(\n    halfColumn * 0.62,\n    halfColumn,\n    abs(uv.x - 0.5)\n  );\n  float frontGlow = 1.0 - smoothstep(\n    0.0,\n    max(blockRange, 0.0001),\n    frontDistance\n  );\n  float softField = column * frontGlow * fieldIntensity;\n  float rayWave = 0.5 + 0.5 * sin(\n    (uv.x * max(rayDensity, 1.0) + time * 0.13) * 6.2831853\n  );\n  float thinRays = pow(rayWave, 18.0);\n  float rayPulse = 0.5 + 0.5 * sin(\n    (localY * 3.0 - time * raySpeed) * 6.2831853\n  );\n  thinRays *= column * frontGlow * mix(0.25, 1.0, rayPulse);\n  vec2 grid = max(blockGrid, vec2(1.0));\n  float blockRow = floor(localY * grid.y);\n  float rowDirection = hash12(vec2(blockRow, 4.17)) * 2.0 - 1.0;\n  float rowSpeed = mix(0.65, 1.45, hash12(vec2(blockRow, 12.83)));\n  float rowPhase = hash12(vec2(blockRow, 27.41)) * 6.2831853;\n  float verticalWobble = sin(time * 5.5 + rowPhase) * 0.012;\n  float glitchTick = floor(time * max(glitchRate, 0.01));\n  float rowGlitch = hash12(vec2(blockRow, glitchTick));\n  float glitchGate = step(0.72, rowGlitch);\n  float glitchDirection = hash12(vec2(blockRow + 31.7, glitchTick)) * 2.0 - 1.0;\n  float horizontalJump = glitchGate * glitchDirection * glitchStrength * grid.x;\n  vec2 blockUV = vec2(\n    uv.x * grid.x\n      + time * blockSpeed * rowSpeed * rowDirection\n      + horizontalJump,\n    (localY + verticalWobble) * grid.y\n  );\n  vec2 blockCell = floor(blockUV);\n  vec2 blockLocal = fract(blockUV);\n  float blockSeed = hash12(blockCell + vec2(3.1, 7.9));\n  float blockAlive = step(0.66, blockSeed);\n  float halfWidth = mix(0.24, 0.49, hash12(blockCell + 8.3));\n  float halfHeight = mix(0.04, 0.13, hash12(blockCell + 17.1));\n  float blockShape = step(abs(blockLocal.x - 0.5), halfWidth)\n    * step(abs(blockLocal.y - 0.5), halfHeight);\n  