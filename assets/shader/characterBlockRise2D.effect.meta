      "glsl1": {
        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\nattribute vec4 a_color;\nvarying vec4 v_color;\n#if USE_TEXTURE\n  attribute vec2 a_uv0;\n  varying vec2 v_uv0;\n#endif\nvoid main() {\n  vec4 position = vec4(a_position, 1.0);\n  #if CC_USE_MODEL\n    position = cc_matViewProj * cc_matWorld * position;\n  #else\n    position = cc_matViewProj * position;\n  #endif\n  gl_Position = position;\n  v_color = a_color;\n  #if USE_TEXTURE\n    v_uv0 = a_uv0;\n  #endif\n}",
        "frag": "\nprecision highp float;\nvarying vec4 v_color;\n#if USE_TEXTURE\n  varying vec2 v_uv0;\n  uniform sampler2D texture;\n#endif\nuniform vec4 baseColor;\nuniform vec4 accentColor;\nuniform vec4 highlightColor;\nuniform vec4 uvRect;\nuniform vec2 blockGrid;\nuniform float time;\nuniform float aspectRatio;\nuniform float density;\nuniform float riseSpeed;\nuniform float drift;\nuniform float sizeMin;\nuniform float sizeMax;\nuniform float edgeSoftness;\nuniform float glowWidth;\nuniform float glowIntensity;\nuniform float emissionStrength;\nuniform float opacity;\nuniform float edgeFade;\nuniform float bottomFade;\nuniform float topFade;\nuniform float centerWidth;\nuniform float auraWidth;\nuniform float auraIntensity;\nuniform float flipY;\nfloat hash12(vec2 p) {\n  vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n  p3 += dot(p3, p3.yzx + 33.33);\n  return fract((p3.x + p3.y) * p3.z);\n}\nvec3 blockColor(float key) {\n  vec3 color = mix(baseColor.rgb, accentColor.rgb, smoothstep(0.32, 0.78, key));\n  return mix(color, highlightColor.rgb, smoothstep(0.84, 1.0, key));\n}\nvec4 blockLayer(\n  vec2 uv,\n  vec2 grid,\n  float layerSeed,\n  float speedScale,\n  float densityScale,\n  float sizeScale\n) {\n  grid = max(grid, vec2(1.0));\n  float movingY = uv.y - time * riseSpeed * speedScale;\n  vec2 cellPosition = vec2(uv.x, movingY) * grid;\n  vec2 cellId = floor(cellPosition);\n  vec2 cellUV = fract(cellPosition);\n  float aliveKey = hash12(cellId + vec2(layerSeed, layerSeed * 1.73));\n  float alive = step(1.0 - clamp(density * densityScale, 0.0, 0.98), aliveKey);\n  float centerKey = hash12(cellId + vec2(layerSeed * 4.17, 19.31));\n  float verticalKey = hash12(cellId + vec2(51.7, layerSeed * 2.9));\n  vec2 center = vec2(\n    mix(0.34, 0.66, centerKey),\n    mix(0.32, 0.68, verticalKey)\n  );\n  center.x += sin(time * mix(0.72, 1.28, centerKey) + aliveKey * 6.2831853)\n    * drift\n    * grid.x;\n  float sizeKey = hash12(cellId + vec2(7.13, layerSeed * 8.21));\n  float halfSize = mix(sizeMin, max(sizeMin, sizeMax), sizeKey) * sizeScale;\n  halfSize = clamp(halfSize, 0.025, 0.46);\n  vec2 blockDistance = abs(cellUV - center);\n  float cellAspect = max(aspectRatio * grid.y / grid.x, 0.0001);\n  blockDistance.x *= cellAspect;\n  float squareDistance = max(blockDistance.x, blockDistance.y) - halfSize;\n  float softness = max(edgeSoftness, 0.0001);\n  float core = 1.0 - smoothstep(0.0, softness, squareDistance);\n  float glow = 1.0 - smoothstep(\n    softness,\n    softness + max(glowWidth, 0.0001),\n    squareDistance\n  );\n  float pulse = mix(\n    0.76,\n    1.0,\n    0.5 + 0.5 * sin(time * mix(2.1, 4.0, sizeKey) + centerKey * 6.2831853)\n  );\n  float alpha = (core + glow * glowIntensity) * alive * pulse;\n  vec3 ownColor = blockColor(hash12(cellId + vec2(layerSeed * 11.7)));\n  float emission = 1.0 + max(emissionStrength, 0.0)\n    * (core * 0.78 + glow * 0.22);\n  return vec4(ownColor * emission, alpha);\n}\nvoid main() {\n  vec2 uvSize = max(uvRect.zw, vec2(0.000001));\n  vec2 uv = (v_uv0 - uvRect.xy) / uvSize;\n  uv.y = mix(1.0 - uv.y, uv.y, step(0.5, flipY));\n  vec4 farBlocks = blockLayer(\n    uv,\n    blockGrid * vec2(0.62, 0.62),\n    3.7,\n    0.68,\n    0.3,\n    1.15\n  );\n  vec4 middleBlocks = blockLayer(\n    uv,\n    blockGrid,\n    17.3,\n    1.0,\n    0.5,\n    1.0\n  );\n  vec4 nearBlocks = blockLayer(\n    uv,\n    blockGrid * vec2(1.58, 1.58),\n    41.9,\n    1.32,\n    0.24,\n    0.7\n  );\n  float safeEdgeFade = max(edgeFade, 0.0001);\n  float edgeMask = smoothstep(0.0, safeEdgeFade, uv.x)\n    * (1.0 - smoothstep(1.0 - safeEdgeFade, 1.0, uv.x));\n  float halfWidth = clamp(centerWidth * 0.5, 0.02, 0.49);\n  float fieldMask = 1.0 - smoothstep(\n    halfWidth,\n    min(0.5, halfWidth + max(edgeFade, 0.03)),\n    abs(uv.x - 0.5)\n  );\n  float verticalMask = smoothstep(0.0, max(bottomFade, 0.0001), uv.y)\n    * (1.0 - smoothstep(\n      1.0 - max(topFade, 0.0001),\n      1.0,\n      uv.y\n    ));\n  float fieldFade = edgeMask * fieldMask * verticalMask;\n  float alphaSum = farBlocks.a + middleBlocks.a + nearBlocks.a;\n  vec3 colorSum = farBlocks.rgb * farBlocks.a\n    + middleBlocks.rgb * middleBlocks.a\n    + nearBlocks.rgb * nearBlocks.a;\n  vec3 blocksRGB = colorSum / max(alphaSum, 0.0001);\n  float blocksAlpha = clamp(alphaSum, 0.0, 1.0) * fieldFade;\n  float aura = 1.0 - smoothstep(\n    0.0,\n    max(auraWidth, 0.0001),\n    abs(uv.x - 0.5)\n  );\n  aura *= verticalMask * max(auraIntensity, 0.0);\n  aura *= 0.78 + 0.22 * sin((uv.y * 3.0 - time * riseSpeed) * 6.2831853);\n  float finalAlpha = max(blocksAlpha, aura) * opacity * v_color.a;\n  if (finalAlpha < 0.001) {\n    discard;\n  }\n  float blockMix = clamp(blocksAlpha / max(finalAlpha, 0.0001), 0.0, 1.0);\n  vec3 finalColor = mix(baseColor.rgb, blocksRGB, blockMix) * v_color.rgb;\n  gl_FragColor = vec4(finalColor, clamp(finalAlpha, 0.0, 1.0));\n}"
      },
      "glsl3": {
        "vert": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nuniform CCLocal {\n  mat4 cc_matWorld;\n  mat4 cc_matWorldIT;\n};\nin vec3 a_position;\nin vec4 a_color;\nout vec4 v_color;\n#if USE_TEXTURE\n  in vec2 a_uv0;\n  out vec2 v_uv0;\n#endif\nvoid main() {\n  vec4 position = vec4(a_position, 1.0);\n  #if CC_USE_MODEL\n    position = cc_matViewProj * cc_matWorld * position;\n  #else\n    position = cc_matViewProj * position;\n  #endif\n  gl_Position = position;\n  v_color = a_color;\n  #if USE_TEXTURE\n    v_uv0 = a_uv0;\n  #endif\n}",
        "frag": "\nprecision highp float;\nin vec4 v_color;\n#if USE_TEXTURE\n  in vec2 v_uv0;\n  uniform sampler2D texture;\n#endif\nuniform CharacterBlockRise {\n  vec4 baseColor;\n  vec4 accentColor;\n  vec4 highlightColor;\n  vec4 uvRect;\n  vec2 blockGrid;\n  float time;\n  float aspectRatio;\n  float density;\n  float riseSpeed;\n  float drift;\n  float sizeMin;\n  float sizeMax;\n  float edgeSoftness;\n  float glowWidth;\n  float glowIntensity;\n  float emissionStrength;\n  float opacity;\n  float edgeFade;\n  float bottomFade;\n  float topFade;\n  float centerWidth;\n  float auraWidth;\n  float auraIntensity;\n  float flipY;\n};\nfloat hash12(vec2 p) {\n  vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n  p3 += dot(p3, p3.yzx + 33.33);\n  return fract((p3.x + p3.y) * p3.z);\n}\nvec3 blockColor(float key) {\n  vec3 color = mix(baseColor.rgb, accentColor.rgb, smoothstep(0.32, 0.78, key));\n  return mix(color, highlightColor.rgb, smoothstep(0.84, 1.0, key));\n}\nvec4 blockLayer(\n  vec2 uv,\n  vec2 grid,\n  float layerSeed,\n  float speedScale,\n  float densityScale,\n  float sizeScale\n) {\n  grid = max(grid, vec2(1.0));\n  float movingY = uv.y - time * riseSpeed * speedScale;\n  vec2 cellPosition = vec2(uv.x, movingY) * grid;\n  vec2 cellId = floor(cellPosition);\n  vec2 cellUV = fract(cellPosition);\n  float aliveKey = hash12(cellId + vec2(layerSeed, layerSeed * 1.73));\n  float alive = step(1.0 - clamp(density * densityScale, 0.0, 0.98), aliveKey);\n  float centerKey = hash12(cellId + vec2(layerSeed * 4.17, 19.31));\n  float verticalKey = hash12(cellId + vec2(51.7, layerSeed * 2.9));\n  vec2 center = vec2(\n    mix(0.34, 0.66, centerKey),\n    mix(0.32, 0.68, verticalKey)\n  );\n  center.x += sin(time * mix(0.72, 1.28, centerKey) + aliveKey * 6.2831853)\n    * drift\n    * grid.x;\n  float sizeKey = hash12(cellId + vec2(7.13, layerSeed * 8.21));\n  float halfSize = mix(sizeMin, max(sizeMin, sizeMax), sizeKey) * sizeScale;\n  halfSize = clamp(halfSize, 0.025, 0.46);\n  vec2 blockDistance = abs(cellUV - center);\n  float cellAspect = max(aspectRatio * grid.y / grid.x, 0.0001);\n  blockDistance.x *= cellAspect;\n  float squareDistance = max(blockDistance.x, blockDistance.y) - halfSize;\n  float softness = max(edgeSoftness, 0.0001);\n  float core = 1.0 - smoothstep(0.0, softness, squareDistance);\n  float glow = 1.0 - smoothstep(\n    softness,\n    softness + max(glowWidth, 0.0001),\n    squareDistance\n  );\n  float pulse = mix(\n    0.76,\n    1.0,\n    0.5 + 0.5 * sin(time * mix(2.1, 4.0, sizeKey) + centerKey * 6.2831853)\n  );\n  float alpha = (core + glow * glowIntensity) * alive * pulse;\n  vec3 ownColor = blockColor(hash12(cellId + vec2(layerSeed * 11.7)));\n  float emission = 1.0 + max(emissionStrength, 0.0)\n    * (core * 0.78 + glow * 0.22);\n  return vec4(ownColor * emission, alpha);\n}\nvoid main() {\n  vec2 uvSize = max(uvRect.zw, vec2(0.000001));\n  vec2 uv = (v_uv0 - uvRect.xy) / uvSize;\n  uv.y = mix(1.0 - uv.y, uv.y, step(0.5, flipY));\n  vec4 farBlocks = blockLayer(\n    uv,\n    blockGrid * vec2(0.62, 0.62),\n    3.7,\n    0.68,\n    0.3,\n    1.15\n  );\n  vec4 middleBlocks = blockLayer(\n    uv,\n    blockGrid,\n    17.3,\n    1.0,\n    0.5,\n    1.0\n  );\n  vec4 nearBlocks = blockLayer(\n    uv,\n    blockGrid * vec2(1.58, 1.58),\n    41.9,\n    1.32,\n    0.24,\n    0.7\n  );\n  float safeEdgeFade = max(edgeFade, 0.0001);\n  float edgeMask = smoothstep(0.0, safeEdgeFade, uv.x)\n    * (1.0 - smoothstep(1.0 - safeEdgeFade, 1.0, uv.x));\n  float halfWidth = clamp(centerWidth * 0.5, 0.02, 0.49);\n  float fieldMask = 1.0 - smoothstep(\n    halfWidth,\n    min(0.5, halfWidth + max(edgeFade, 0.03)),\n    abs(uv.x - 0.5)\n  );\n  float verticalMask = smoothstep(0.0, max(bottomFade, 0.0001), uv.y)\n    * (1.0 - smoothstep(\n      1.0 - max(topFade, 0.0001),\n      1.0,\n      uv.y\n    ));\n  float fieldFade = edgeMask * fieldMask * verticalMask;\n  float alphaSum = farBlocks.a + middleBlocks.a + nearBlocks.a;\n  vec3 colorSum = farBlocks.rgb * farBlocks.a\n    + middleBlocks.rgb * middleBlocks.a\n    + nearBlocks.rgb * nearBlocks.a;\n  vec3 blocksRGB = colorSum / max(alphaSum, 0.0001);\n  float blocksAlpha = clamp(alphaSum, 0.0, 1.0) * fieldFade;\n  float aura = 1.0 - smoothstep(\n    0.0,\n    max(auraWidth, 0.0001),\n    abs(uv.x - 0.5)\n  );\n  aura *= verticalMask * max(auraIntensity, 0.0);\n  aura *= 0.78 + 0.22 * sin((uv.y * 3.0 - time * riseSpeed) * 6.2831853);\n  float finalAlpha = max(blocksAlpha, aura) * opacity * v_color.a;\n  if (finalAlpha < 0.001) {\n    discard;\n  }\n  float blockMix = clamp(blocksAlpha / max(finalAlpha, 0.0001), 0.0, 1.0);\n  vec3 finalColor = mix(baseColor.rgb, blocksRGB, blockMix) * v_color.rgb;\n  gl_FragColor = vec4(finalColor, clamp(finalAlpha, 0.0, 1.0));\n}"
