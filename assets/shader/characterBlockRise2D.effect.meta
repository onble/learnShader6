        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\nattribute vec4 a_color;\nvarying vec4 v_color;\n#if USE_TEXTURE\n  attribute vec2 a_uv0;\n  varying vec2 v_uv0;\n#endif\nvoid main() {\n  vec4 position = vec4(a_position, 1.0);\n  #if CC_USE_MODEL\n    position = cc_matViewProj * cc_matWorld * position;\n  #else\n    position = cc_matViewProj * position;\n  #endif\n  gl_Position = position;\n  v_color = a_color;\n  #if USE_TEXTURE\n    v_uv0 = a_uv0;\n  #endif\n}",
        "frag": "\nprecision highp float;\nvarying vec4 v_color;\n#if USE_TEXTURE\n  varying vec2 v_uv0;\n  uniform sampler2D texture;\n#endif\nuniform vec4 baseColor;\nuniform vec4 accentColor;\nuniform vec4 highlightColor;\nuniform vec4 uvRect;\nuniform vec2 blockGrid;\nuniform float time;\nuniform float widthTime;\nuniform float aspectRatio;\nuniform float density;\nuniform float drift;\nuniform float sizeMin;\nuniform float sizeMax;\nuniform float edgeSoftness;\nuniform float glowWidth;\nuniform float glowIntensity;\nuniform float emissionStrength;\nuniform float opacity;\nuniform float edgeFade;\nuniform float bottomFade;\nuniform float topFade;\nuniform float centerWidth;\nuniform float auraWidth;\nuniform float auraIntensity;\nuniform float auraPulseStrength;\nuniform float flipY;\nfloat hash12(vec2 p) {\n  vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n  p3 += dot(p3, p3.yzx + 33.33);\n  return fract((p3.x + p3.y) * p3.z);\n}\nvec3 screenColor(float key) {\n  vec3 color = mix(baseColor.rgb, accentColor.rgb, smoothstep(0.32, 0.78, key));\n  return mix(color, highlightColor.rgb, smoothstep(0.9, 1.0, key));\n}\nvec4 blockLayer(\n  vec2 uv,\n  vec2 grid,\n  float layerSeed,\n  float speedScale,\n  float densityScale,\n  float sizeScale\n) {\n  grid = max(grid, vec2(1.0));\n  float motionPhase = time\n    + 0.0358099 * sin(time * 6.2831853)\n    + 0.0059683 * sin(time * 12.5663706);\n  float riseCycles = 1.0 + step(0.8, speedScale) + step(1.2, speedScale);\n  float movingY = uv.y - motionPhase * riseCycles;\n  vec2 cellPosition = vec2(uv.x, movingY) * grid;\n  vec2 cellId = floor(cellPosition);\n  vec2 cellUV = fract(cellPosition);\n  float densityRise = smoothstep(0.0, 0.35, time);\n  float densityFall = 1.0 - smoothstep(0.42, 1.0, time);\n  float densityEnvelope = 0.24 * densityRise * densityFall;\n  float aliveKey = hash12(cellId + vec2(layerSeed, layerSeed * 1.73));\n  float alive = step(\n    1.0 - clamp(density * densityScale * densityEnvelope, 0.0, 0.98),\n    aliveKey\n  );\n  float centerKey = hash12(cellId + vec2(layerSeed * 4.17, 19.31));\n  float verticalKey = hash12(cellId + vec2(51.7, layerSeed * 2.9));\n  vec2 center = vec2(\n    mix(0.34, 0.66, centerKey),\n    mix(0.32, 0.68, verticalKey)\n  );\n  float driftFrequency = 1.0 + step(0.5, centerKey);\n  center.x += sin((time * driftFrequency + aliveKey) * 6.2831853)\n    * drift\n    * grid.x;\n  float sizeKey = hash12(cellId + vec2(7.13, layerSeed * 8.21));\n  float halfHeight = mix(sizeMin, max(sizeMin, sizeMax), sizeKey) * sizeScale;\n  halfHeight = clamp(halfHeight, 0.025, 0.26);\n  float shapeKey = hash12(cellId + vec2(29.4, layerSeed * 5.71));\n  float widthRatio = mix(1.20, 2.25, shapeKey);\n  float widthPulseKey = hash12(cellId + vec2(83.6, layerSeed * 3.17));\n  float widthPhase = fract(widthTime * 0.12 + widthPulseKey);\n  float widthAppear = smoothstep(0.0, 0.08, widthPhase);\n  float widthCollapse = 1.0 - smoothstep(0.18, 0.92, widthPhase);\n  float widthPulse = widthAppear * widthCollapse;\n  float animatedPanel = step(0.64, widthPulseKey) * (1.0 - step(0.8, speedScale));\n  float halfWidth = halfHeight * widthRatio * mix(1.0, widthPulse, animatedPanel);\n  halfWidth = clamp(halfWidth, 0.002, 0.47);\n  vec2 blockDistance = abs(cellUV - center);\n  float cellAspect = max(aspectRatio * grid.y / grid.x, 0.0001);\n  blockDistance.x *= cellAspect;\n  vec2 panelSize = vec2(halfWidth, halfHeight);\n  float panelDistance = max(blockDistance.x - panelSize.x, blockDistance.y - panelSize.y);\n  float softness = max(edgeSoftness, 0.0001);\n  float outerPanel = 1.0 - smoothstep(0.0, softness, panelDistance);\n  float frameWidth = clamp(halfHeight * 0.12, 0.010, 0.035);\n  vec2 innerSize = max(panelSize - vec2(frameWidth), vec2(0.006));\n  float innerDistance = max(blockDistance.x - innerSize.x, blockDistance.y - innerSize.y);\n  float innerPanel = 1.0 - smoothstep(0.0, softness, innerDistance);\n  float frame = clamp(outerPanel - innerPanel, 0.0, 1.0);\n  float glow = 1.0 - smoothstep(\n    softness,\n    softness + max(glowWidth, 0.0001),\n    panelDistance\n  );\n  float edgePhase = hash12(cellId + vec2(12.9, layerSeed * 7.3));\n  float energyFrequency = 4.0 + 2.0 * step(0.5, edgePhase);\n  float energyFlow = 0.55 + 0.45 * sin(\n    (cellUV.x * 7.0 + cellUV.y * 5.0 - time * energyFrequency + edgePhase) * 6.2831853\n  );\n  float cornerX = 1.0 - smoothstep(innerSize.x * 0.42, innerSize.x, blockDistance.x);\n  float cornerY = 1.0 - smoothstep(innerSize.y * 0.42, innerSize.y, blockDistance.y);\n  float cornerLight = frame * cornerX * cornerY;\n  float pulseFrequency = 2.0 + floor(sizeKey * 3.0);\n  float pulse = mix(\n    0.76,\n    1.0,\n    0.5 + 0.5 * sin((time * pulseFrequency + centerKey) * 6.2831853)\n  );\n  float widthVisibility = mix(1.0, smoothstep(0.01, 0.12, widthPulse), animatedPanel);\n  float alpha = (frame * (0.92 + energyFlow * 0.58)\n    + glow * glowIntensity * 0.46\n    + innerPanel * 0.10) * alive * pulse * widthVisibility;\n  vec3 ownColor = screenColor(hash12(cellId + vec2(layerSeed * 11.7)));\n  vec3 shieldColor = mix(baseColor.rgb, accentColor.rgb, shapeKey);\n  vec3 rimColor = mix(shieldColor, highlightColor.rgb, 0.48 + energyFlow * 0.36);\n  vec3 innerColor = shieldColor * (0.10 + energyFlow * 0.08);\n  vec3 panelColor = rimColor * frame * (1.45 + energyFlow * max(emissionStrength, 0.0));\n  panelColor += highlightColor.rgb * cornerLight * 2.1;\n  panelColor += shieldColor * glow * glowIntensity * 0.78;\n  panelColor += innerColor * innerPanel;\n  return vec4(panelColor, alpha);\n}\nvoid main() {\n  vec2 uvSize = max(uvRect.zw, vec2(0.000001));\n  vec2 uv = (v_uv0 - uvRect.xy) / uvSize;\n  uv.y = mix(1.0 - uv.y, uv.y, step(0.5, flipY));\n  vec4 farBlocks = blockLayer(\n    uv,\n    blockGrid * vec2(0.62, 0.62),\n    3.7,\n    0.68,\n    0.3,\n    1.15\n  );\n  vec4 middleBlocks = blockLayer(\n    uv,\n    blockGrid,\n    17.3,\n    1.0,\n    0.5,\n    1.0\n  );\n  vec4 nearBlocks = blockLayer(\n    uv,\n    blockGrid * vec2(1.58, 1.58),\n    41.9,\n    1.32,\n    0.24,\n    0.7\n  );\n  float safeEdgeFade = max(edgeFade, 0.0001);\n  float edgeMask = smoothstep(0.0, safeEdgeFade, uv.x)\n    * (1.0 - smoothstep(1.0 - safeEdgeFade, 1.0, uv.x));\n  float halfWidth = clamp(centerWidth * 0.5, 0.02, 0.49);\n  float fieldMask = 1.0 - smoothstep(\n    halfWidth,\n    min(0.5, halfWidth + max(edgeFade, 0.03)),\n    abs(uv.x - 0.5)\n  );\n  float verticalMask = smoothstep(0.0, max(bottomFade, 0.0001), uv.y)\n    * (1.0 - smoothstep(\n      1.0 - max(topFade, 0.0001),\n      1.0,\n      uv.y\n    ));\n  float fieldFade = edgeMask * fieldMask * verticalMask;\n  float alphaSum = farBlocks.a + middleBlocks.a + nearBlocks.a;\n  vec3 colorSum = farBlocks.rgb * farBlocks.a\n    + middleBlocks.rgb * middleBlocks.a\n    + nearBlocks.rgb * nearBlocks.a;\n  vec3 blocksRGB = colorSum / max(alphaSum, 0.0001);\n  float blocksAlpha = clamp(alphaSum, 0.0, 1.0) * fieldFade;\n  float aura = 1.0 - smoothstep(\n    0.0,\n    max(auraWidth, 0.0001),\n    abs(uv.x - 0.5)\n  );\n  float auraWave = sin(time * 3.14159265);\n  float animatedAuraIntensity = max(auraIntensity, 0.0)\n    * (1.0 + max(auraPulseStrength, 0.0) * auraWave * auraWave);\n  aura *= verticalMask * animatedAuraIntensity;\n  aura *= 0.78 + 0.22 * sin((uv.y * 3.0 - time * 2.0) * 6.2831853);\n  float finalAlpha = max(blocksAlpha, aura) * opacity * v_color.a;\n  if (finalAlpha < 0.001) {\n    discard;\n  }\n  float blockMix = clamp(blocksAlpha / max(finalAlpha, 0.0001), 0.0, 1.0);\n  vec3 finalColor = mix(baseColor.rgb, blocksRGB, blockMix) * v_color.rgb;\n  gl_FragColor = vec4(finalColor, clamp(finalAlpha, 0.0, 1.0));\n}"
