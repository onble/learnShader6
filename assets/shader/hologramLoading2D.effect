CCEffect %{
techniques:
  - passes:
      - vert: vs
        frag: fs
        blendState:
          targets:
            - blend: true
        rasterizerState:
          cullMode: none
        properties:
          texture: { value: white }
          energyColor:
            { value: [0.0, 0.42, 1.0, 1.0], editor: { type: color, tooltip: "全息能量颜色" } }
          highlightColor:
            { value: [0.2, 1.0, 1.0, 1.0], editor: { type: color, tooltip: "扫描亮带与数据块高光颜色" } }
          blockColorA:
            { value: [0.18, 1.0, 0.86, 1.0], editor: { type: color, tooltip: "青绿色数据块颜色" } }
          blockColorB:
            { value: [1.0, 0.16, 0.62, 1.0], editor: { type: color, tooltip: "粉色数据块颜色" } }
          blockColorC:
            { value: [0.68, 0.22, 1.0, 1.0], editor: { type: color, tooltip: "紫色数据块颜色" } }
          uvRect: { value: [0.0, 0.0, 1.0, 1.0], editor: { tooltip: "SpriteFrame 在纹理或动态图集中的 UV 区域" } }
          progress: { value: 0.0, editor: { tooltip: "加载进度：0 到 1" } }
          scanWidth: { value: 0.045, editor: { tooltip: "扫描亮带宽度" } }
          scanIntensity: { value: 1.8, editor: { tooltip: "扫描亮带亮度" } }
          blockGrid: { value: [11.0, 18.0], editor: { tooltip: "数据块网格数量（横、纵）" } }
          blockSpeed: { value: 1.25, editor: { tooltip: "数据块横向漂移速度" } }
          blockIntensity: { value: 0.82, editor: { tooltip: "数据块透明度" } }
          blockRange: { value: 0.42, editor: { tooltip: "数据块在扫描边缘附近的分布范围" } }
          fieldIntensity: { value: 0.2, editor: { tooltip: "中央能量场透明度" } }
          columnWidth: { value: 0.7, editor: { tooltip: "中央能量柱宽度" } }
          rayDensity: { value: 14.0, editor: { tooltip: "竖向光丝密度" } }
          raySpeed: { value: 1.0, editor: { tooltip: "竖向光丝流动速度" } }
          glitchStrength: { value: 0.065, editor: { tooltip: "数据块水平跳动距离" } }
          glitchRate: { value: 15.0, editor: { tooltip: "数据块跳动刷新频率" } }
          edgeFade: { value: 0.08, editor: { tooltip: "特效区域边缘淡出宽度" } }
          endFadeStart: { value: 0.84, editor: { tooltip: "完成前从哪个进度开始淡出" } }
          flipY: { value: 0.0, editor: { tooltip: "扫描方向相反时设为 1" } }
}%

CCProgram vs %{
precision highp float;

#include <cc-global>
#include <cc-local>

in vec3 a_position;
in vec4 a_color;

out vec4 v_color;

#if USE_TEXTURE
  in vec2 a_uv0;
  out vec2 v_uv0;
#endif

void main() {
  vec4 position = vec4(a_position, 1.0);

  #if CC_USE_MODEL
    position = cc_matViewProj * cc_matWorld * position;
  #else
    position = cc_matViewProj * position;
  #endif

  gl_Position = position;
  v_color = a_color;

  #if USE_TEXTURE
    v_uv0 = a_uv0;
  #endif
}
}%

CCProgram fs %{
precision highp float;

#include <cc-global>

in vec4 v_color;

// Sprite 仍需要一个纹理属性来建立渲染四边形，但本 Shader 不采样它。
// 因此 default_sprite 仅作为透明特效的载体，不会显示在最终画面中。
#if USE_TEXTURE
  in vec2 v_uv0;
  uniform sampler2D texture;
#endif

uniform HologramLoading {
  vec4 energyColor;
  vec4 highlightColor;
  vec4 blockColorA;
  vec4 blockColorB;
  vec4 blockColorC;
  vec4 uvRect;
  vec2 blockGrid;
  float progress;
  float scanWidth;
  float scanIntensity;
  float blockSpeed;
  float blockIntensity;
  float blockRange;
  float fieldIntensity;
  float columnWidth;
  float rayDensity;
  float raySpeed;
  float glitchStrength;
  float glitchRate;
  float edgeFade;
  float endFadeStart;
  float flipY;
};

float hash12(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * 0.1031);
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.x + p3.y) * p3.z);
}

void main() {
  vec2 uvSize = max(uvRect.zw, vec2(0.000001));
  vec2 uv = (v_uv0 - uvRect.xy) / uvSize;
  float time = cc_time.x;
  float currentProgress = clamp(progress, 0.0, 1.0);
  float localY = mix(1.0 - uv.y, uv.y, step(0.5, flipY));

  // 四周软裁切，确保这个 Sprite 始终表现为透明的特效层，而不是矩形图片。
  float fadeWidth = max(edgeFade, 0.0001);
  float edgeMaskX = smoothstep(0.0, fadeWidth, uv.x)
    * (1.0 - smoothstep(1.0 - fadeWidth, 1.0, uv.x));
  float edgeMaskY = smoothstep(0.0, fadeWidth, localY)
    * (1.0 - smoothstep(1.0 - fadeWidth, 1.0, localY));
  float edgeMask = edgeMaskX * edgeMaskY;

  // 加载完成前逐渐将特效淡掉，为真正的模型或 UI 内容腾出画面。
  float startLife = 0.45 + 0.55 * smoothstep(0.0, 0.08, currentProgress);
  float endLife = 1.0 - smoothstep(
    clamp(endFadeStart, 0.0, 0.99),
    1.0,
    currentProgress
  );
  float life = startLife * endLife;

  float frontDistance = abs(localY - currentProgress);
  float safeScanWidth = max(scanWidth, 0.0001);
  float scanBand = 1.0 - smoothstep(0.0, safeScanWidth, frontDistance);
  float scanEcho = 1.0 - smoothstep(
    0.0,
    safeScanWidth * 2.6,
    abs(localY - currentProgress + safeScanWidth * 2.2)
  );

  // 中央仅保留一层很淡的能量雾和竖向光丝，不生成任何实体底图。
  float halfColumn = max(columnWidth * 0.5, 0.001);
  float column = 1.0 - smoothstep(
    halfColumn * 0.62,
    halfColumn,
    abs(uv.x - 0.5)
  );
  float frontGlow = 1.0 - smoothstep(
    0.0,
    max(blockRange, 0.0001),
    frontDistance
  );
  float softField = column * frontGlow * fieldIntensity;

  float rayWave = 0.5 + 0.5 * sin(
    (uv.x * max(rayDensity, 1.0) + time * 0.13) * 6.2831853
  );
  float thinRays = pow(rayWave, 18.0);
  float rayPulse = 0.5 + 0.5 * sin(
    (localY * 3.0 - time * raySpeed) * 6.2831853
  );
  thinRays *= column * frontGlow * mix(0.25, 1.0, rayPulse);

  // 每行使用独立速度和方向。两层长条交错反向漂移，模拟参考效果里
  // 青、粉、紫色数据条快速穿过扫描柱的运动。
  vec2 grid = max(blockGrid, vec2(1.0));
  float blockRow = floor(localY * grid.y);
  float rowDirection = hash12(vec2(blockRow, 4.17)) * 2.0 - 1.0;
  float rowSpeed = mix(0.65, 1.45, hash12(vec2(blockRow, 12.83)));
  float rowPhase = hash12(vec2(blockRow, 27.41)) * 6.2831853;
  float verticalWobble = sin(time * 5.5 + rowPhase) * 0.012;

  float glitchTick = floor(time * max(glitchRate, 0.01));
  float rowGlitch = hash12(vec2(blockRow, glitchTick));
  float glitchGate = step(0.72, rowGlitch);
  float glitchDirection = hash12(vec2(blockRow + 31.7, glitchTick)) * 2.0 - 1.0;
  float horizontalJump = glitchGate * glitchDirection * glitchStrength * grid.x;

  vec2 blockUV = vec2(
    uv.x * grid.x
      + time * blockSpeed * rowSpeed * rowDirection
      + horizontalJump,
    (localY + verticalWobble) * grid.y
  );
  vec2 blockCell = floor(blockUV);
  vec2 blockLocal = fract(blockUV);
  float blockSeed = hash12(blockCell + vec2(3.1, 7.9));
  float blockAlive = step(0.66, blockSeed);
  float halfWidth = mix(0.24, 0.49, hash12(blockCell + 8.3));
  float halfHeight = mix(0.04, 0.13, hash12(blockCell + 17.1));
  float blockShape = step(abs(blockLocal.x - 0.5), halfWidth)
    * step(abs(blockLocal.y - 0.5), halfHeight);
  float blockZone = 1.0 - smoothstep(
    0.0,
    max(blockRange, 0.0001),
    frontDistance
  );
  float blockPulse = smoothstep(
    0.12,
    0.72,
    0.5 + 0.5 * sin(time * 15.0 + blockSeed * 20.0)
  );
  float blockAlpha = blockShape * blockAlive * blockZone * blockPulse;
  blockAlpha *= blockIntensity;

  vec2 grid2 = vec2(max(grid.x * 0.72, 1.0), max(grid.y * 1.18, 1.0));
  float blockRow2 = floor((localY + 0.027) * grid2.y);
  float rowDirection2 = hash12(vec2(blockRow2, 39.6)) * 2.0 - 1.0;
  float rowSpeed2 = mix(0.75, 1.35, hash12(vec2(blockRow2, 51.2)));
  vec2 blockUV2 = vec2(
    uv.x * grid2.x
      + time * blockSpeed * 0.78 * rowSpeed2 * rowDirection2
      - horizontalJump * 0.55
      + 0.37,
    (localY - verticalWobble * 0.72 + 0.027) * grid2.y
  );
  vec2 blockCell2 = floor(blockUV2);
  vec2 blockLocal2 = fract(blockUV2);
  float blockSeed2 = hash12(blockCell2 + vec2(61.4, 19.7));
  float blockAlive2 = step(0.73, blockSeed2);
  float halfWidth2 = mix(0.28, 0.49, hash12(blockCell2 + 23.7));
  float halfHeight2 = mix(0.035, 0.095, hash12(blockCell2 + 42.6));
  float blockShape2 = step(abs(blockLocal2.x - 0.5), halfWidth2)
    * step(abs(blockLocal2.y - 0.5), halfHeight2);
  float blockPulse2 = smoothstep(
    0.18,
    0.76,
    0.5 + 0.5 * sin(time * 18.0 + blockSeed2 * 24.0)
  );
  float blockAlpha2 = blockShape2 * blockAlive2 * blockZone * blockPulse2;
  blockAlpha2 *= blockIntensity * 0.86;

  float blockColorKey = hash12(blockCell + vec2(91.3, 44.1));
  vec3 blockRGB = mix(blockColorA.rgb, blockColorB.rgb, step(0.46, blockColorKey));
  blockRGB = mix(blockRGB, blockColorC.rgb, step(0.82, blockColorKey));
  float blockColorKey2 = hash12(blockCell2 + vec2(73.8, 102.4));
  vec3 blockRGB2 = mix(blockColorA.rgb, blockColorB.rgb, step(0.42, blockColorKey2));
  blockRGB2 = mix(blockRGB2, blockColorC.rgb, step(0.78, blockColorKey2));

  float combinedBlockAlpha = max(blockAlpha, blockAlpha2);
  vec3 combinedBlockRGB = mix(
    blockRGB,
    blockRGB2,
    step(blockAlpha, blockAlpha2)
  );

  // 少量更长、更薄的 Glitch 横条快速扫过，强化一秒周期内的速度感。
  float streakRow = floor(localY * 46.0);
  float streakSeed = hash12(vec2(streakRow, glitchTick));
  float streakGate = step(0.88, streakSeed);
  float streakDirection = hash12(vec2(streakRow + 5.8, 31.2)) * 2.0 - 1.0;
  float streakCenter = fract(
    hash12(vec2(streakRow + 9.4, glitchTick))
      + time * blockSpeed * 0.18 * streakDirection
  );
  float streakWidth = mix(0.08, 0.26, hash12(vec2(streakRow + 18.2, glitchTick)));
  float streak = 1.0 - smoothstep(
    streakWidth,
    streakWidth + 0.012,
    abs(uv.x - streakCenter)
  );
  streak *= streakGate * blockZone;

  float scanAlpha = (scanBand * 0.88 + scanEcho * 0.28) * column;
  float rayAlpha = thinRays * fieldIntensity * 0.7;
  float fieldAlpha = softField * 0.42;
  float streakAlpha = streak * blockIntensity * 0.68;

  float effectAlpha = max(scanAlpha, combinedBlockAlpha);
  effectAlpha = max(effectAlpha, rayAlpha + fieldAlpha);
  effectAlpha = max(effectAlpha, streakAlpha);
  effectAlpha *= edgeMask * life * v_color.a;

  if (effectAlpha < 0.001) {
    discard;
  }

  float highlight = clamp(
    scanBand * scanIntensity + combinedBlockAlpha * 0.32,
    0.0,
    1.0
  );
  vec3 color = mix(energyColor.rgb, highlightColor.rgb, highlight);
  float streakColorKey = hash12(vec2(streakRow, glitchTick + 67.3));
  vec3 streakRGB = mix(blockColorA.rgb, blockColorB.rgb, step(0.38, streakColorKey));
  streakRGB = mix(streakRGB, blockColorC.rgb, step(0.84, streakColorKey));
  float dataAlpha = max(combinedBlockAlpha, streakAlpha);
  vec3 dataRGB = mix(
    combinedBlockRGB,
    streakRGB,
    step(combinedBlockAlpha, streakAlpha)
  );
  float dataMix = clamp(dataAlpha / max(effectAlpha, 0.0001), 0.0, 1.0);
  color = mix(color, dataRGB, dataMix * 0.92);
  color *= 0.82 + scanBand * scanIntensity + thinRays * 0.45;
  color *= v_color.rgb;

  gl_FragColor = vec4(color, clamp(effectAlpha, 0.0, 1.0));
}
}%
