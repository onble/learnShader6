        "frag": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nvarying vec2 v_uv0;\nvarying vec4 v_color;\nuniform sampler2D texture;\nuniform HueColor {\n  vec4 baseColor;\n  vec4 shallowColor;\n  vec4 edgeColor;\n  float scale;\n  float speed;\n  float distortion;\n  float edgeWidth;\n  float edgeSoftness;\n  float glowStrength;\n  float flowStrength;\n  float bubbleStrength;\n};\nfloat hash21(vec2 p) {\n  p = fract(p * vec2(123.34, 456.21));\n  p += dot(p, p + 45.32);\n  return fract(p.x * p.y);\n}\nvec2 hash22(vec2 p) {\n  float n = hash21(p);\n  return vec2(n, hash21(p + n));\n}\nfloat noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  vec2 u = f * f * (3.0 - 2.0 * f);\n  float a = hash21(i);\n  float b = hash21(i + vec2(1.0, 0.0));\n  float c = hash21(i + vec2(0.0, 1.0));\n  float d = hash21(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfloat fbm(vec2 p) {\n  float v = 0.0;\n  float a = 0.5;\n  for(int i = 0; i < 4; i ++ ) {\n    v += noise(p) * a;\n    p *= 2.0;\n    a *= 0.5;\n  }\n  return v;\n}\nfloat voronoiEdge(vec2 p) {\n  vec2 g = floor(p);\n  vec2 f = fract(p);\n  float d1 = 10.0;\n  float d2 = 10.0;\n  for(int y = -1; y <= 1; y ++ ) {\n    for(int x = -1; x <= 1; x ++ ) {\n      vec2 lattice = vec2(float(x), float(y));\n      vec2 offset = hash22(g + lattice);\n      offset = 0.5 + 0.5 * sin(cc_time.x * speed + 6.2831 * offset);\n      vec2 r = lattice + offset - f;\n      float d = dot(r, r);\n      if (d < d1) {\n        d2 = d1;\n        d1 = d;\n      } else if (d < d2) {\n        d2 = d;\n      }\n    }\n  }\n  return sqrt(d2) - sqrt(d1);\n}\nvoid main() {\n  vec2 uv = v_uv0;\n  float t = cc_time.x;\n  vec4 texColor = texture2D(texture, uv);\n  vec2 flowUv = uv;\n  flowUv.x += fbm(uv * 3.0 + t * 0.06) * distortion;\n  flowUv.y += fbm(uv * 3.0 - t * 0.05) * distortion;\n  vec2 p = flowUv * scale;\n  float edge = voronoiEdge(p);\n  float mainEdge = 1.0 - smoothstep(edgeWidth, edgeWidth + edgeSoftness, edge);\n  float glow = 1.0 - smoothstep(edgeWidth + 0.05, edgeWidth + 0.35, edge);\n  float waterShade = fbm(uv * 2.5 + vec2(t * 0.02, - t * 0.015));\n  vec3 col = mix(baseColor.rgb, shallowColor.rgb, waterShade * 0.35);\n  col += edgeColor.rgb * mainEdge * glowStrength;\n  col += edgeColor.rgb * glow * 0.35;\n  float flowLine = sin((uv.x + fbm(uv * 5.0 + t * 0.08)) * 35.0 + uv.y * 18.0 + t * 1.5);\n  flowLine = smoothstep(0.92, 1.0, flowLine);\n  flowLine *= fbm(uv * 8.0 - t * 0.04);\n  col += edgeColor.rgb * flowLine * flowStrength;\n  vec2 buv = uv * 8.0;\n  vec2 cell = floor(buv);\n  vec2 f = fract(buv);\n  vec2 rnd = hash22(cell);\n  float bubbleChance = step(0.78, rnd.x);\n  float radius = mix(0.06, 0.16, rnd.y);\n  float d = length(f - rnd);\n  float bubbles = 1.0 - smoothstep(0.018, 0.035, abs(d - radius));\n  bubbles *= bubbleChance;\n  col += edgeColor.rgb * bubbles * bubbleStrength;\n  float alpha = texColor.a * baseColor.a * v_color.a;\n  gl_FragColor = vec4(col, alpha);\n}"
